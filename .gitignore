cat > .gitignore <<'EOF'
# Secrets and environment
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node.js / Next.js
node_modules/
.next/
out/
dist/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local data
data/
uploads/
*.sqlite3
*.db

# Logs
*.log
EOF